{
  "name": "phoenixdx-poc",
  "version": "1.9.9",
  "author": "Procomcure Biotech Germany",
  "description": "Frontend app to operate POC PCR-Cycler",
  "repository": {
    "type": "git",
    "url": "https://github.com/lroenfeldt/phoenixdx-poc/"
  },
  "private": true,
  "main": "public/electron.js",
  "scripts": {
    "start": "vite start",
    "build": "vite build",
    "test": "vite test",
    "eject": "vite eject",
    "dev": "concurrently \"cross-env BROWSER=none vite --host --port 3000\" \"wait-on tcp:3000 && electron .\"",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "package": "npm run build &&  electron-builder -w -c.extraMetadata.main=build/electron.js --publish never",
    "deploy": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js --publish always",
    "deploy-beta": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js -c.publish.provider=github -c.publish.releaseType=prerelease --publish always"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "apisauce": "^2.1.5",
    "auto-launch": "^5.0.6",
    "axios": "^1.4.0",
    "chart.js": "^4.3.0",
    "date-fns": "^2.30.0",
    "electron-is-dev": "^2.0.0",
    "electron-shutdown-command": "^2.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^5.3.0",
    "fs": "^0.0.1-security",
    "getmac": "^5.20.0",
    "hddserial": "^0.0.7",
    "history": "^5.3.0",
    "i18n-js": "^3.9.2",
    "jsonwebtoken": "^9.0.0",
    "jwt-decode": "^3.1.2",
    "macaddress": "^0.5.3",
    "node-machine-id": "^1.1.12",
    "path": "^0.12.7",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.9.0",
    "react-loader-spinner": "^5.3.4",
    "react-router-dom": "^6.12.1",
    "react-simple-keyboard": "^3.5.43",
    "react-toggle": "^4.1.3",
    "serial-number": "^1.3.0",
    "serialport": "^11.0.0",
    "swiper": "^9.3.2",
    "uuid": "^9.0.0",
    "web-vitals": "^3.3.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "electron": "^25.1.0",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.1",
    "electronmon": "^2.0.2",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "react-scripts": "5.0.1",
    "vite": "^4.3.9",
    "wait-on": "^7.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version",
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 electron version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "./"
}
