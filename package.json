    "electron-store": "^8.0.2",
    "electron-updater": "^5.0.5",
    "fs": "^0.0.1-security",
    "getmac": "^5.20.0",
    "hddserial": "^0.0.7",
    "history": "^5.3.0",
    "i18n-js": "^3.9.2",
    "jsonwebtoken": "^8.5.1",
