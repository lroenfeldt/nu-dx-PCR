  "private": true,
  "main": "public/electron.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "concurrently \"cross-env BROWSER=none npm run start\" \"wait-on http://127.0.0.1:3000 && electronmon .\"",
    "package": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js --publish never",
    "deploy": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js --publish always"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version",
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 electron version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "./",
  "devDependencies": {
    "@faker-js/faker": "^7.5.0",
    "concurrently": "^7.1.0",
    "cross-env": "^7.0.3",
    "electron": "^17.1.0",
    "electron-builder": "^23.0.3",
    "electron-packager": "^15.4.0",
    "electronmon": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.0",
    "wait-on": "^6.0.1"
  }
